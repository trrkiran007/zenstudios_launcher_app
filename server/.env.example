# Copy this file to server/.env
# SQLite path is resolved relative to prisma/schema.prisma
DATABASE_URL="file:../../data/app.db"

# The API listens here. Deliberately API_PORT, not PORT, so it never fights
# the Vite dev server.
API_PORT=4321

# Optional. Enables competitor-quote analysis and the PDF rate-card importer.
# You can also paste this key in the app's Settings screen instead.
# ANTHROPIC_API_KEY=sk-ant-...
